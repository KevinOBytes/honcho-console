# Optional overrides. HONCHO_API_KEY may be omitted when ~/.honcho/config.json exists.
HONCHO_BASE_URL=http://127.0.0.1:8000
# Optional preferred workspace; the UI also discovers and lets you edit/select it.
HONCHO_WORKSPACE=oasis
HONCHO_API_KEY=
HONCHO_ALLOW_REMOTE=false
# HONCHO_CONFIG_PATH=/Users/your-user/.honcho/config.json
